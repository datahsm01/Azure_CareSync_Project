{
	"name": "pl_source_to_silver_inner",
	"properties": {
		"activities": [
			{
				"name": "Read Table Details",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 2,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": {
							"value": "SELECT * FROM ctrl.table_config\nWHERE table_id = @{pipeline().parameters.table_id}",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "ds_azure_sql_database",
						"type": "DatasetReference"
					},
					"firstRowOnly": true
				}
			},
			{
				"name": "Set Start Time",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "start_time",
					"value": {
						"value": "@formatDateTime(utcNow(),'yyyy-MM-dd_hh:mm:ss')",
						"type": "Expression"
					}
				}
			},
			{
				"name": "1 Landing to Bronze",
				"type": "DatabricksNotebook",
				"dependsOn": [
					{
						"activity": "Switch1",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"notebookPath": "/Users/hv.ade@outlook.com/CareSync-Project/Azure_CareSync_Project/Azure Databricks/1_Landing_to_Bronze",
					"baseParameters": {
						"landing_timestamp": {
							"value": "@variables('start_time')",
							"type": "Expression"
						},
						"source_system": {
							"value": "@activity('Read Table Details').output.firstRow.source_system",
							"type": "Expression"
						},
						"table_name": {
							"value": "@activity('Read Table Details').output.firstRow.bronze_table_name",
							"type": "Expression"
						}
					}
				},
				"linkedServiceName": {
					"referenceName": "ls_azureDatabricks",
					"type": "LinkedServiceReference"
				}
			},
			{
				"name": "2 Bronze to Silver",
				"type": "DatabricksNotebook",
				"dependsOn": [
					{
						"activity": "1 Landing to Bronze",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"notebookPath": "/Users/hv.ade@outlook.com/CareSync-Project/Azure_CareSync_Project/Azure Databricks/2_Bronze_to_Silver",
					"baseParameters": {
						"landing_timestamp": {
							"value": "@variables('start_time')",
							"type": "Expression"
						},
						"table_name": {
							"value": "@activity('Read Table Details').output.firstRow.silver_table_name",
							"type": "Expression"
						},
						"merge_keys": {
							"value": "@coalesce(activity('Read Table Details').output.firstRow.merge_keys, '')\n\n",
							"type": "Expression"
						},
						"load_type": {
							"value": "@activity('Read Table Details').output.firstRow.load_type",
							"type": "Expression"
						}
					}
				},
				"linkedServiceName": {
					"referenceName": "ls_azureDatabricks",
					"type": "LinkedServiceReference"
				}
			},
			{
				"name": "Update Success Status",
				"type": "Script",
				"dependsOn": [
					{
						"activity": "2 Bronze to Silver",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"linkedServiceName": {
					"referenceName": "ls_azuresqldatabase",
					"type": "LinkedServiceReference"
				},
				"typeProperties": {
					"scripts": [
						{
							"type": "Query",
							"text": {
								"value": "UPDATE ctrl.audit_log\nSET \n    STATUS = 'SUCCESS', \n    end_time = SYSUTCDATETIME(),\n    records_written = '@{activity('2 Bronze to Silver').output.runOutput}'\nWHERE \n    adf_run_id = '@{pipeline().parameters.adf_run_id}' \nAND \n    table_id = @{pipeline().parameters.table_id};",
								"type": "Expression"
							}
						}
					],
					"scriptBlockExecutionTimeout": "02:00:00"
				}
			},
			{
				"name": "Check Load Type",
				"type": "IfCondition",
				"dependsOn": [
					{
						"activity": "Read Table Details",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "Set Start Time",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@not(equals(activity('Read Table Details').output.firstRow.load_type, 'FULL'))",
						"type": "Expression"
					},
					"ifTrueActivities": [
						{
							"name": "Read Watermark Value",
							"type": "Lookup",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "AzureSqlSource",
									"sqlReaderQuery": {
										"value": "SELECT watermark_value\nFROM\n    ctrl.watermark\nWHERE\n    table_id = @{pipeline().parameters.table_id};",
										"type": "Expression"
									},
									"queryTimeout": "02:00:00",
									"partitionOption": "None"
								},
								"dataset": {
									"referenceName": "ds_azure_sql_database",
									"type": "DatasetReference"
								}
							}
						},
						{
							"name": "Store Watermark Value",
							"type": "SetVariable",
							"dependsOn": [
								{
									"activity": "Read Watermark Value",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"variableName": "watermark_value",
								"value": {
									"value": "@activity('Read Watermark Value').output.firstRow.watermark_value",
									"type": "Expression"
								}
							}
						}
					]
				}
			},
			{
				"name": "Checking Load Type and Update Watermark",
				"type": "IfCondition",
				"dependsOn": [
					{
						"activity": "2 Bronze to Silver",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@not(equals(activity('Read Table Details').output.firstRow.load_type, 'FULL'))",
						"type": "Expression"
					},
					"ifTrueActivities": [
						{
							"name": "Update Watermark",
							"type": "Script",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"linkedServiceName": {
								"referenceName": "ls_azuresqldatabase",
								"type": "LinkedServiceReference"
							},
							"typeProperties": {
								"scripts": [
									{
										"type": "Query",
										"text": {
											"value": "UPDATE ctrl.watermark\nSET \n    watermark_value = SYSUTCDATETIME()\nWHERE \n    table_id = @{pipeline().parameters.table_id}",
											"type": "Expression"
										}
									}
								],
								"scriptBlockExecutionTimeout": "02:00:00"
							}
						}
					]
				}
			},
			{
				"name": "Switch1",
				"type": "Switch",
				"dependsOn": [
					{
						"activity": "Check Load Type",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"on": {
						"value": "@activity('Read Table Details').output.firstRow.source_system",
						"type": "Expression"
					},
					"cases": [
						{
							"value": "neon_postgres",
							"activities": [
								{
									"name": "Source to Landing Ingestion",
									"type": "Copy",
									"dependsOn": [],
									"policy": {
										"timeout": "0.12:00:00",
										"retry": 0,
										"retryIntervalInSeconds": 30,
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"source": {
											"type": "PostgreSqlV2Source",
											"query": {
												"value": "SELECT * FROM public.@{activity('Read Table Details').output.firstRow.source_table_name}\n@{\n    if(equals(activity('Read Table Details').output.firstRow.load_type, 'FULL'), '', \n        concat('where ', activity('Read Table Details').output.firstRow.watermark_column, ' > ' , '''', variables('watermark_value'), '''')\n    )\n}",
												"type": "Expression"
											},
											"queryTimeout": "02:00:00"
										},
										"sink": {
											"type": "ParquetSink",
											"storeSettings": {
												"type": "AzureBlobFSWriteSettings"
											},
											"formatSettings": {
												"type": "ParquetWriteSettings"
											}
										},
										"enableStaging": false,
										"translator": {
											"type": "TabularTranslator",
											"typeConversion": true,
											"typeConversionSettings": {
												"allowDataTruncation": true,
												"treatBooleanAsNumber": false
											}
										}
									},
									"inputs": [
										{
											"referenceName": "ds_postgresqltable",
											"type": "DatasetReference"
										}
									],
									"outputs": [
										{
											"referenceName": "ds_parquet",
											"type": "DatasetReference",
											"parameters": {
												"container": "landing",
												"folder": {
													"value": "@concat(\nactivity('Read Table Details').output.firstRow.source_system,\n'/',\nactivity('Read Table Details').output.firstRow.source_table_name,\n'/', \nvariables('start_time')\n)",
													"type": "Expression"
												}
											}
										}
									]
								}
							]
						},
						{
							"value": "adls_csv"
						}
					]
				}
			}
		],
		"parameters": {
			"table_id": {
				"type": "int",
				"defaultValue": 1
			},
			"adf_run_id": {
				"type": "string",
				"defaultValue": "a7"
			}
		},
		"variables": {
			"start_time": {
				"type": "String"
			},
			"watermark_value": {
				"type": "String"
			}
		},
		"annotations": []
	}
}